# Copy to .env.local for local dev. All optional.
# Without a checkout configured: in `npm run dev` the Upgrade modal offers a demo "Activate Pro" button;
# in production builds there is NO demo unlock (Upgrade just says "checkout opens soon").
# Production (GitHub Pages) values live in .env.production. They're baked in at build time, so run `npm run deploy` after changes.

# Easiest path: a Stripe Payment Link (no backend). Set its success URL to
#   https://nikfuz.github.io/billmint/?checkout=success
VITE_STRIPE_PAYMENT_LINK=

# Alternative: Gumroad product URL (used if no Stripe Payment Link is set)
VITE_GUMROAD_URL=

# Future: Stripe Checkout Sessions via the included Vercel function (api/create-checkout-session.js)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_ID=
VITE_CHECKOUT_ENDPOINT=/api/create-checkout-session

# Server-side only (Vercel project env, NOT prefixed with VITE_):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# APP_URL=https://your-domain.com
